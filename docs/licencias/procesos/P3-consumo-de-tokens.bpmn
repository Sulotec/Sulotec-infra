<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_P3" targetNamespace="http://sulotec.com/licencias" exporter="Sulotec" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_P3">
    <bpmn:participant id="Pool_P3" name="Sulotec · Consumo de la bolsa de tokens" processRef="Proceso_P3" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P3" name="Consumo de tokens" isExecutable="false">
    <bpmn:laneSet id="Carriles_P3">
      <bpmn:lane id="Carril_P3_0" name="Usuario">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P3_1" name="Producto (sistema)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P3_2" name="Administrador de empresa">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Ejecuta una consulta">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Verificar la bolsa">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Hay saldo?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t2" name="Ejecutar y registrar">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="¿Pasó el 80 %?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="¿Dentro de la tolerancia?">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t4" name="Ejecutar y marcar exceso">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="Bloquear y ofrecer ampliar">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t3" name="Revisar aviso del 80 %">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e3" name="Aviso revisado">
      <bpmn:incoming>f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t6" name="Ampliar bolsa o plan (P4)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e2" name="Bloqueado hasta ampliar">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e1" name="Consulta atendida">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" sourceRef="g1" targetRef="t2" name="Sí" />
    <bpmn:sequenceFlow id="f4" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="f5" sourceRef="g2" targetRef="e1" name="No" />
    <bpmn:sequenceFlow id="f6" sourceRef="g2" targetRef="t3" name="Sí" />
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="e3" />
    <bpmn:sequenceFlow id="f8" sourceRef="g1" targetRef="g3" name="No" />
    <bpmn:sequenceFlow id="f9" sourceRef="g3" targetRef="t4" name="Sí" />
    <bpmn:sequenceFlow id="f10" sourceRef="t4" targetRef="e1" />
    <bpmn:sequenceFlow id="f11" sourceRef="g3" targetRef="t5" name="No" />
    <bpmn:sequenceFlow id="f12" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f13" sourceRef="t6" targetRef="e2" />
  </bpmn:process>
