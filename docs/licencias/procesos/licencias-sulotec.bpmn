<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_Licencias_Sulotec" name="Licencias de Sulotec" targetNamespace="http://sulotec.com/licencias" exporter="Sulotec" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_Licencias" name="Licencias de Sulotec">
    <bpmn:participant id="P1_pool" name="P1 · Contratación y alta de licencia" processRef="P1_proceso" />
    <bpmn:participant id="P2_pool" name="P2 · Gestión de usuarios de la empresa" processRef="P2_proceso" />
    <bpmn:participant id="P3_pool" name="P3 · Consumo de tokens" processRef="P3_proceso" />
    <bpmn:participant id="P4_pool" name="P4 · Renovación, ampliación y vencimiento" processRef="P4_proceso" />
  </bpmn:collaboration>
  <bpmn:process id="P1_proceso" name="Contratación y alta de licencia" isExecutable="false">
    <bpmn:laneSet id="P1_carriles">
      <bpmn:lane id="P1_carril0" name="Empresa cliente">
        <bpmn:flowNodeRef>P1_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_carril1" name="Comercial Sulotec">
        <bpmn:flowNodeRef>P1_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_carril2" name="Administrador Universal">
        <bpmn:flowNodeRef>P1_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_carril3" name="Plataforma Sulotec">
        <bpmn:flowNodeRef>P1_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_s1" name="Pide un producto">
      <bpmn:outgoing>P1_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P1_t1" name="Cotizar el plan (usuarios y tokens)">
      <bpmn:incoming>P1_f1</bpmn:incoming>
      <bpmn:outgoing>P1_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P1_g1" name="¿Acepta?">
      <bpmn:incoming>P1_f2</bpmn:incoming>
      <bpmn:outgoing>P1_f3</bpmn:outgoing>
      <bpmn:outgoing>P1_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P1_e0" name="No contrata">
      <bpmn:incoming>P1_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P1_t2" name="Firmar contrato y pagar">
      <bpmn:incoming>P1_f4</bpmn:incoming>
      <bpmn:outgoing>P1_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P1_t3" name="Crear empresa y licencia">
      <bpmn:incoming>P1_f5</bpmn:incoming>
      <bpmn:outgoing>P1_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1_t4" name="Sincronizar licencia al producto">
      <bpmn:incoming>P1_f6</bpmn:incoming>
      <bpmn:outgoing>P1_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P1_t5" name="Invitar al Admin. General">
      <bpmn:incoming>P1_f7</bpmn:incoming>
      <bpmn:outgoing>P1_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P1_t6" name="Enviar invitación por correo">
      <bpmn:incoming>P1_f8</bpmn:incoming>
      <bpmn:outgoing>P1_f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P1_t7" name="Activar cuenta y 2.º factor">
      <bpmn:incoming>P1_f9</bpmn:incoming>
      <bpmn:outgoing>P1_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P1_e1" name="Empresa operando">
      <bpmn:incoming>P1_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_f1" sourceRef="P1_s1" targetRef="P1_t1" />
    <bpmn:sequenceFlow id="P1_f2" sourceRef="P1_t1" targetRef="P1_g1" />
    <bpmn:sequenceFlow id="P1_f3" sourceRef="P1_g1" targetRef="P1_e0" name="No" />
    <bpmn:sequenceFlow id="P1_f4" sourceRef="P1_g1" targetRef="P1_t2" name="Sí" />
    <bpmn:sequenceFlow id="P1_f5" sourceRef="P1_t2" targetRef="P1_t3" />
    <bpmn:sequenceFlow id="P1_f6" sourceRef="P1_t3" targetRef="P1_t4" />
    <bpmn:sequenceFlow id="P1_f7" sourceRef="P1_t4" targetRef="P1_t5" />
    <bpmn:sequenceFlow id="P1_f8" sourceRef="P1_t5" targetRef="P1_t6" />
    <bpmn:sequenceFlow id="P1_f9" sourceRef="P1_t6" targetRef="P1_t7" />
    <bpmn:sequenceFlow id="P1_f10" sourceRef="P1_t7" targetRef="P1_e1" />
  </bpmn:process>
  <bpmn:process id="P2_proceso" name="Gestión de usuarios de la empresa" isExecutable="false">
    <bpmn:laneSet id="P2_carriles">
      <bpmn:lane id="P2_carril0" name="Administrador General">
        <bpmn:flowNodeRef>P2_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_carril1" name="Producto (sistema)">
        <bpmn:flowNodeRef>P2_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_carril2" name="Usuario">
        <bpmn:flowNodeRef>P2_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_s1" name="Necesita un usuario">
      <bpmn:outgoing>P2_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2_t1" name="Registrar datos y rol">
      <bpmn:incoming>P2_f1</bpmn:incoming>
      <bpmn:outgoing>P2_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_t2" name="Validar cupo de usuarios">
      <bpmn:incoming>P2_f2</bpmn:incoming>
      <bpmn:outgoing>P2_f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_g1" name="¿Hay cupo?">
      <bpmn:incoming>P2_f3</bpmn:incoming>
      <bpmn:outgoing>P2_f4</bpmn:outgoing>
      <bpmn:outgoing>P2_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_t3" name="Crear cuenta e invitar">
      <bpmn:incoming>P2_f4</bpmn:incoming>
      <bpmn:outgoing>P2_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2_t4" name="Ver límite y pedir ampliar">
      <bpmn:incoming>P2_f5</bpmn:incoming>
      <bpmn:outgoing>P2_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P2_e2" name="Pendiente de ampliar (P4)">
      <bpmn:incoming>P2_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P2_t5" name="Activar cuenta y 2.º factor">
      <bpmn:incoming>P2_f7</bpmn:incoming>
      <bpmn:outgoing>P2_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P2_e1" name="Usuario activo">
      <bpmn:incoming>P2_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P2_s2" name="Alguien deja la empresa">
      <bpmn:outgoing>P2_f9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2_t6" name="Desactivar al usuario">
      <bpmn:incoming>P2_f9</bpmn:incoming>
      <bpmn:outgoing>P2_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P2_t7" name="Liberar el cupo">
      <bpmn:incoming>P2_f10</bpmn:incoming>
      <bpmn:outgoing>P2_f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P2_e3" name="Cupo liberado">
      <bpmn:incoming>P2_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_f1" sourceRef="P2_s1" targetRef="P2_t1" />
    <bpmn:sequenceFlow id="P2_f2" sourceRef="P2_t1" targetRef="P2_t2" />
    <bpmn:sequenceFlow id="P2_f3" sourceRef="P2_t2" targetRef="P2_g1" />
    <bpmn:sequenceFlow id="P2_f4" sourceRef="P2_g1" targetRef="P2_t3" name="Sí" />
    <bpmn:sequenceFlow id="P2_f5" sourceRef="P2_g1" targetRef="P2_t4" name="No" />
    <bpmn:sequenceFlow id="P2_f6" sourceRef="P2_t4" targetRef="P2_e2" />
    <bpmn:sequenceFlow id="P2_f7" sourceRef="P2_t3" targetRef="P2_t5" />
    <bpmn:sequenceFlow id="P2_f8" sourceRef="P2_t5" targetRef="P2_e1" />
    <bpmn:sequenceFlow id="P2_f9" sourceRef="P2_s2" targetRef="P2_t6" />
    <bpmn:sequenceFlow id="P2_f10" sourceRef="P2_t6" targetRef="P2_t7" />
    <bpmn:sequenceFlow id="P2_f11" sourceRef="P2_t7" targetRef="P2_e3" />
  </bpmn:process>
  <bpmn:process id="P3_proceso" name="Consumo de tokens" isExecutable="false">
    <bpmn:laneSet id="P3_carriles">
      <bpmn:lane id="P3_carril0" name="Usuario">
        <bpmn:flowNodeRef>P3_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_carril1" name="Producto (sistema)">
        <bpmn:flowNodeRef>P3_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_carril2" name="Administrador General">
        <bpmn:flowNodeRef>P3_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_s1" name="Ejecuta una consulta">
      <bpmn:outgoing>P3_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P3_t1" name="Verificar la bolsa">
      <bpmn:incoming>P3_f1</bpmn:incoming>
      <bpmn:outgoing>P3_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_g1" name="¿Hay saldo?">
      <bpmn:incoming>P3_f2</bpmn:incoming>
      <bpmn:outgoing>P3_f3</bpmn:outgoing>
      <bpmn:outgoing>P3_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3_t2" name="Ejecutar y registrar">
      <bpmn:incoming>P3_f3</bpmn:incoming>
      <bpmn:outgoing>P3_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_g2" name="¿Pasó el 80 %?">
      <bpmn:incoming>P3_f4</bpmn:incoming>
      <bpmn:outgoing>P3_f5</bpmn:outgoing>
      <bpmn:outgoing>P3_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P3_g3" name="¿Dentro de la tolerancia?">
      <bpmn:incoming>P3_f8</bpmn:incoming>
      <bpmn:outgoing>P3_f9</bpmn:outgoing>
      <bpmn:outgoing>P3_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3_t4" name="Ejecutar y marcar exceso">
      <bpmn:incoming>P3_f9</bpmn:incoming>
      <bpmn:outgoing>P3_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3_t5" name="Bloquear y ofrecer ampliar">
      <bpmn:incoming>P3_f11</bpmn:incoming>
      <bpmn:outgoing>P3_f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P3_t3" name="Revisar aviso del 80 %">
      <bpmn:incoming>P3_f6</bpmn:incoming>
      <bpmn:outgoing>P3_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P3_e3" name="Aviso revisado">
      <bpmn:incoming>P3_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P3_t6" name="Ampliar bolsa o plan (P4)">
      <bpmn:incoming>P3_f12</bpmn:incoming>
      <bpmn:outgoing>P3_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P3_e2" name="Bloqueado hasta ampliar">
      <bpmn:incoming>P3_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P3_e1" name="Consulta atendida">
      <bpmn:incoming>P3_f5</bpmn:incoming>
      <bpmn:incoming>P3_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P3_f1" sourceRef="P3_s1" targetRef="P3_t1" />
    <bpmn:sequenceFlow id="P3_f2" sourceRef="P3_t1" targetRef="P3_g1" />
    <bpmn:sequenceFlow id="P3_f3" sourceRef="P3_g1" targetRef="P3_t2" name="Sí" />
    <bpmn:sequenceFlow id="P3_f4" sourceRef="P3_t2" targetRef="P3_g2" />
    <bpmn:sequenceFlow id="P3_f5" sourceRef="P3_g2" targetRef="P3_e1" name="No" />
    <bpmn:sequenceFlow id="P3_f6" sourceRef="P3_g2" targetRef="P3_t3" name="Sí" />
    <bpmn:sequenceFlow id="P3_f7" sourceRef="P3_t3" targetRef="P3_e3" />
    <bpmn:sequenceFlow id="P3_f8" sourceRef="P3_g1" targetRef="P3_g3" name="No" />
    <bpmn:sequenceFlow id="P3_f9" sourceRef="P3_g3" targetRef="P3_t4" name="Sí" />
    <bpmn:sequenceFlow id="P3_f10" sourceRef="P3_t4" targetRef="P3_e1" />
    <bpmn:sequenceFlow id="P3_f11" sourceRef="P3_g3" targetRef="P3_t5" name="No" />
    <bpmn:sequenceFlow id="P3_f12" sourceRef="P3_t5" targetRef="P3_t6" />
    <bpmn:sequenceFlow id="P3_f13" sourceRef="P3_t6" targetRef="P3_e2" />
  </bpmn:process>
  <bpmn:process id="P4_proceso" name="Renovación, ampliación y vencimiento" isExecutable="false">
    <bpmn:laneSet id="P4_carriles">
      <bpmn:lane id="P4_carril0" name="Plataforma Sulotec">
        <bpmn:flowNodeRef>P4_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_carril1" name="Administrador General">
        <bpmn:flowNodeRef>P4_s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_carril2" name="Comercial Sulotec">
        <bpmn:flowNodeRef>P4_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_carril3" name="Administrador Universal">
        <bpmn:flowNodeRef>P4_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P4_s1" name="7 días antes del vencimiento">
      <bpmn:outgoing>P4_f1</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P4_t1" name="Avisar vencimiento y consumo">
      <bpmn:incoming>P4_f1</bpmn:incoming>
      <bpmn:outgoing>P4_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="P4_s2" name="Pide ampliar desde la app">
      <bpmn:outgoing>P4_f3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P4_g1" name="¿Qué decide?">
      <bpmn:incoming>P4_f2</bpmn:incoming>
      <bpmn:incoming>P4_f3</bpmn:incoming>
      <bpmn:outgoing>P4_f4</bpmn:outgoing>
      <bpmn:outgoing>P4_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P4_t2" name="Cotizar renovación o ampliación">
      <bpmn:incoming>P4_f4</bpmn:incoming>
      <bpmn:outgoing>P4_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P4_t3" name="Pagar">
      <bpmn:incoming>P4_f5</bpmn:incoming>
      <bpmn:outgoing>P4_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P4_t4" name="Actualizar la licencia">
      <bpmn:incoming>P4_f6</bpmn:incoming>
      <bpmn:outgoing>P4_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P4_t5" name="Aplicar en el producto">
      <bpmn:incoming>P4_f7</bpmn:incoming>
      <bpmn:outgoing>P4_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P4_e1" name="Licencia vigente">
      <bpmn:incoming>P4_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P4_t6" name="Al vencer: 7 días solo lectura">
      <bpmn:incoming>P4_f9</bpmn:incoming>
      <bpmn:outgoing>P4_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P4_t7" name="Suspender acceso (datos a salvo)">
      <bpmn:incoming>P4_f10</bpmn:incoming>
      <bpmn:outgoing>P4_f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P4_e2" name="Licencia suspendida">
      <bpmn:incoming>P4_f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P4_f1" sourceRef="P4_s1" targetRef="P4_t1" />
    <bpmn:sequenceFlow id="P4_f2" sourceRef="P4_t1" targetRef="P4_g1" />
    <bpmn:sequenceFlow id="P4_f3" sourceRef="P4_s2" targetRef="P4_g1" />
    <bpmn:sequenceFlow id="P4_f4" sourceRef="P4_g1" targetRef="P4_t2" name="Renovar o ampliar" />
    <bpmn:sequenceFlow id="P4_f5" sourceRef="P4_t2" targetRef="P4_t3" />
