---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { pilares } from '../data/sitio';
---
<section class="pilares" id="pilares" aria-labelledby="titulo-pilares">
  <svg class="curva-arriba" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0H1440V40C1000 100 420 20 0 70Z" fill="#e4eaf3" />
    <path d="M0 78C420 28 1000 108 1440 48" fill="none" stroke="#ed1c24" stroke-width="8" />
  </svg>
  <span class="burbuja b1" aria-hidden="true"></span>
  <span class="burbuja b2" aria-hidden="true"></span>
  <div class="contenedor">
    <SectionTitle id="titulo-pilares" kicker="Por qué Sulotec" titulo="Los pilares detrás de cada solución" bajada="Una misma plataforma, segura y en la nube, para todo el ecosistema." claro />
    <div class="rejilla">
      {pilares.map((p, i) => (
        <div class="pilar revelar" style={`--i:${i}`}>
          <span class="icono"><Icon name={p.icono} size={26} /></span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pilares { position: relative; padding: 150px 0 110px; color: #fff; overflow: hidden; background: linear-gradient(120deg, var(--azul-oscuro), var(--azul), var(--azul-claro), var(--azul)); background-size: 300% 300%; animation: deriva 22s ease-in-out infinite; }
  .curva-arriba { position: absolute; left: 0; top: -1px; width: 100%; height: 90px; z-index: 1; }
  .burbuja { position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; animation: flotar 14s ease-in-out infinite; }
  .b1 { width: 380px; height: 380px; left: -100px; bottom: -120px; background: rgba(84, 116, 167, .5); }
  .b2 { width: 260px; height: 260px; right: 8%; top: 140px; background: rgba(237, 28, 36, .12); animation-duration: 18s; }
  .contenedor { position: relative; }
  .rejilla { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .pilar { position: relative; border: 1px solid rgba(255, 255, 255, .16); background: rgba(255, 255, 255, .06); backdrop-filter: blur(6px); border-radius: var(--radio); padding: 30px 24px; transition: background .35s ease, transform .4s var(--curva), border-color .35s ease; }
  .pilar:hover { background: rgba(255, 255, 255, .12); border-color: rgba(255, 255, 255, .32); transform: translateY(-6px); }
  .icono { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--azul); margin-bottom: 20px; transition: transform .4s var(--curva); }
  .pilar:hover .icono { transform: rotate(-10deg) scale(1.08); }
  h3 { font-size: 1.2rem; margin-bottom: 10px; }
  p { margin: 0; color: #d7e0ef; font-size: .97rem; }
  @media (max-width: 1000px) { .rejilla { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .rejilla { grid-template-columns: 1fr; } .pilares { padding-top: 110px; } }
</style>
