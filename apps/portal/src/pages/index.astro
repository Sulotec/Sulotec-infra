---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProductCard from '../components/ProductCard.astro';
import Metodologia from '../components/Metodologia.astro';
import Pilares from '../components/Pilares.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { soluciones } from '../data/soluciones';
---
<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Marquee />

    <section class="soluciones puntos" id="soluciones" aria-labelledby="titulo-soluciones">
      <div class="contenedor">
        <SectionTitle id="titulo-soluciones" kicker="Nuestro ecosistema" titulo="Soluciones para tu empresa" bajada="Cada solución funciona por sí sola y comparte la misma base segura en la nube." />
        <div class="rejilla">
          {soluciones.map((s, i) => <ProductCard solucion={s} indice={i} />)}
        </div>
      </div>
    </section>

    <Metodologia />
    <Pilares />
    <Contacto />
  </main>
  <Footer />
</Base>

<style>
  .soluciones { padding: 96px 0 108px; background: var(--fondo); }
  .soluciones .contenedor { position: relative; }
  .rejilla { display: grid; grid-template-columns: repeat(2, 1fr); gap: 26px; }
  @media (max-width: 760px) { .rejilla { grid-template-columns: 1fr; } }
</style>
