---
import Icon from './Icon.astro';
import { sitio } from '../data/sitio';
const asunto = encodeURIComponent('Quiero conocer las soluciones de Sulotec');
---
<section class="contacto puntos" id="contacto" aria-labelledby="titulo-contacto">
  <div class="contenedor">
    <div class="caja revelar">
      <svg class="adorno" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
        <path d="M120 300C200 200 260 90 400 40V300Z" fill="rgba(255,255,255,.06)" />
        <path class="filete" d="M100 300C190 190 250 80 400 26" fill="none" stroke="#ed1c24" stroke-width="6" />
      </svg>
      <div class="texto">
        <h2 id="titulo-contacto">¿Aún no sabes por dónde empezar?</h2>
        <p>Cuéntanos cómo trabaja tu equipo y te mostramos qué solución te ayuda desde el primer día.</p>
      </div>
      <a class="boton boton-blanco" href={`mailto:${sitio.correo}?subject=${asunto}`}>Hablar con un especialista <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .contacto { padding: 100px 0; background: var(--fondo); }
  .contenedor { position: relative; }
  .caja { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; color: #fff; border-radius: 28px; padding: 60px 56px; box-shadow: var(--sombra-alta);
    background: linear-gradient(120deg, var(--azul-claro), var(--azul), var(--azul-oscuro), var(--azul)); background-size: 300% 300%; animation: deriva 16s ease-in-out infinite; }
  .adorno { position: absolute; right: 0; top: 0; width: 46%; height: 100%; pointer-events: none; }
  .filete { stroke-dasharray: 600; animation: trazar 2.4s var(--curva) both; }
  @keyframes trazar { from { stroke-dashoffset: 600; } to { stroke-dashoffset: 0; } }
  .texto, .boton { position: relative; }
  h2 { font-size: clamp(1.6rem, 2.8vw, 2.25rem); margin-bottom: 10px; }
  p { margin: 0; color: #d7e0ef; max-width: 540px; font-size: 1.05rem; }
  @media (max-width: 720px) { .caja { padding: 38px 26px; } .adorno { width: 80%; opacity: .6; } }
</style>
