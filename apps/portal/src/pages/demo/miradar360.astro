---
import DemoLayout from '../../layouts/DemoLayout.astro';
import Icon from '../../components/Icon.astro';
import { asesores, estadosAsesor, eventos } from '../../data/demos';

const enCampo = asesores.filter((a) => a.estado !== 'termino').length;
const hechas = asesores.reduce((t, a) => t + a.hechas, 0);
const total = asesores.reduce((t, a) => t + a.total, 0);
const avance = Math.round((hechas / total) * 100);
const metricas = [
  { valor: `${enCampo} de ${asesores.length}`, texto: 'asesores en campo ahora' },
  { valor: `${hechas} de ${total}`, texto: 'visitas realizadas hoy' },
  { valor: `${avance}%`, texto: 'avance del plan del día' },
];
---
<DemoLayout
  producto="MiRadar360"
  titulo="Tu equipo en campo, hoy"
  bajada="Elige un asesor para ver su recorrido en el mapa y en qué visita está."
  ruta="/demo/miradar360"
  menu={[
    { texto: 'Planificar rutas', icono: 'mapCheck' },
    { texto: 'Asesores', icono: 'users' },
    { texto: 'Reportes', icono: 'chart' },
    { texto: 'Configuración', icono: 'gear' },
  ]}
>
  <section class="metricas" aria-label="Resumen del día">
    {metricas.map((m) => <div class="metrica"><strong>{m.valor}</strong><span>{m.texto}</span></div>)}
  </section>

  <div class="rejilla">
    <section class="panel asesores" aria-labelledby="t-asesores">
      <h2 id="t-asesores">Asesores</h2>
      <ul>
        {asesores.map((a) => (
          <li>
            <button type="button" class="asesor" data-asesor={a.id} aria-pressed="false" style={`--color:${a.color}`}>
              <span class="avatar">{a.nombre.split(' ').map((p) => p[0]).join('')}</span>
              <span class="datos">
                <strong>{a.nombre}</strong>
                <small>{a.zona}</small>
                <span class="barra-avance" aria-hidden="true"><i style={`width:${Math.round((a.hechas / a.total) * 100)}%`}></i></span>
              </span>
              <span class="lado">
                <span class:list={['estado', a.estado]}>{estadosAsesor[a.estado]}</span>
                <small>{a.hechas} de {a.total} visitas</small>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>

    <section class="panel mapa-panel" aria-labelledby="t-mapa">
      <div class="cabeza">
        <h2 id="t-mapa">Mapa en vivo</h2>
        <button type="button" class="chico" data-bloqueado>Exportar recorrido</button>
      </div>
      <svg class="mapa" viewBox="0 0 600 400" role="img" aria-label="Mapa de ejemplo con los recorridos de los asesores">
        <rect width="600" height="400" rx="16" fill="#f7f9fc" />
        <g stroke="#e3e9f2" stroke-width="10" stroke-linecap="round">
          <path d="M0 110H600M0 210H600M0 310H600M120 0V400M260 0V400M400 0V400M520 0V400" />
        </g>
        <g stroke="#ffffff" stroke-width="2">
          <path d="M0 110H600M0 210H600M0 310H600M120 0V400M260 0V400M400 0V400M520 0V400" />
        </g>
        <path d="M0 360C140 330 260 380 420 350S560 300 600 320V400H0Z" fill="#dce8f7" />
        <ellipse cx="460" cy="95" rx="42" ry="26" fill="#e1f2e7" />
        <ellipse cx="180" cy="260" rx="30" ry="20" fill="#e1f2e7" />
        <g font-size="12" font-weight="700" fill="#8da2c4">
          <text x="300" y="150">San Isidro</text><text x="410" y="290">Miraflores</text>
          <text x="470" y="180">Surquillo</text><text x="150" y="95">Lince</text>
        </g>
        {asesores.map((a) => (
          <g class="ruta" data-ruta={a.id}>
            <path d={a.ruta} fill="none" stroke={a.color} stroke-width="4" stroke-linecap="round" stroke-dasharray="2 9" />
            {a.estado === 'termino'
              ? <circle cx={a.posicion[0]} cy={a.posicion[1]} r="9" fill={a.color} stroke="#fff" stroke-width="3" />
              : <circle r="9" fill={a.color} stroke="#fff" stroke-width="3"><animateMotion dur={`${14 + a.total}s`} repeatCount="indefinite" path={a.ruta} /></circle>}
          </g>
        ))}
      </svg>
      <p class="nota">Las ubicaciones son ilustrativas.</p>
    </section>
  </div>

  <section class="panel actividad" aria-labelledby="t-actividad">
    <div class="cabeza">
      <h2 id="t-actividad">Actividad reciente</h2>
      <button type="button" class="chico" data-bloqueado>Ver historial completo</button>
    </div>
    <ol>
      {eventos.map((e) => (
        <li class={e.tipo}><time>{e.hora}</time><span>{e.texto}</span></li>
      ))}
    </ol>
  </section>
</DemoLayout>

<style>
  .metricas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 18px; }
  .metrica { background: #fff; border: 1px solid var(--borde); border-radius: 14px; padding: 16px 18px; }
  .metrica strong { display: block; font-size: 1.6rem; color: var(--azul); font-variant-numeric: tabular-nums; }
  .metrica span { color: var(--gris); font-size: .92rem; }

  .rejilla { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: 18px; margin-bottom: 18px; }
  .panel { background: #fff; border: 1px solid var(--borde); border-radius: 16px; padding: 18px; }
  h2 { font-size: 1.08rem; color: var(--texto); }
  .cabeza { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; }
  .asesores h2 { margin-bottom: 12px; }
  .chico { background: var(--azul-10); color: var(--azul); border: 0; border-radius: 999px; padding: 7px 14px; font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; }
  .chico:hover { background: var(--azul-25); }

  ul, ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .asesor { width: 100%; display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; text-align: left; padding: 12px; border-radius: 12px; border: 1.5px solid var(--borde); background: #fff; font: inherit; cursor: pointer; transition: border-color .2s ease, background .2s ease; }
  .asesor:hover { border-color: var(--azul-25); }
  .asesor[aria-pressed="true"] { border-color: var(--color); background: color-mix(in srgb, var(--color) 7%, #fff); }
  .avatar { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--color); color: #fff; font-weight: 700; font-size: .9rem; }
  .datos { display: grid; gap: 2px; min-width: 0; }
  .datos small, .lado small { color: var(--gris); font-size: .8rem; }
  .barra-avance { display: block; height: 5px; border-radius: 9px; background: var(--azul-10); margin-top: 4px; overflow: hidden; }
  .barra-avance i { display: block; height: 100%; background: var(--color); border-radius: 9px; }
  .lado { display: grid; justify-items: end; gap: 4px; }
  .estado { font-size: .75rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
  .estado.visita { background: #e5f5ec; color: #0d7a3d; }
  .estado.ruta { background: var(--azul-10); color: var(--azul); }
  .estado.termino { background: #eef0f3; color: var(--gris); }

  .mapa { width: 100%; height: auto; display: block; border-radius: 12px; }
  .ruta { transition: opacity .3s ease; }
  .mapa.atenuado .ruta { opacity: .18; }
  .mapa.atenuado .ruta.activa { opacity: 1; }
  .mapa.atenuado .ruta.activa path { stroke-width: 6; stroke-dasharray: none; }
  .nota { margin: 8px 0 0; font-size: .8rem; color: var(--gris); }

  .actividad ol { gap: 0; }
  .actividad li { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 12px 0; border-top: 1px solid var(--azul-10); }
  .actividad li:first-child { border-top: 0; }
  .actividad time { font-weight: 700; color: var(--azul); font-variant-numeric: tabular-nums; }

  .datos strong { white-space: nowrap; }
  @media (max-width: 1000px) { .rejilla { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .metricas { grid-template-columns: 1fr; }
    .asesor { grid-template-columns: auto 1fr; }
    .lado { grid-column: 2; justify-items: start; grid-auto-flow: column; align-items: center; gap: 8px; }
  }
</style>
