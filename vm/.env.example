# Copia como .env en la VM (cp .env.example .env) y completa.
# Token del tunel: Cloudflare -> Tunnels -> tu tunel -> Docker (el texto largo que empieza con eyJ...)
CF_TUNNEL_TOKEN=

# Genera una con:  openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
POSTGRES_PASSWORD=

# Opcional, para subir backups a Object Storage (valores salen de `terraform output`)
BACKUP_BUCKET=sulotec-backups

# La genera scripts/setup-datos.sh si falta
MYSQL_ROOT_PASSWORD=
