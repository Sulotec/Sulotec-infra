<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_P2" targetNamespace="http://sulotec.com/licencias" exporter="Sulotec" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_P2">
    <bpmn:participant id="Pool_P2" name="Sulotec · Usuarios de la empresa" processRef="Proceso_P2" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P2" name="Gestión de usuarios de la empresa" isExecutable="false">
    <bpmn:laneSet id="Carriles_P2">
      <bpmn:lane id="Carril_P2_0" name="Administrador de empresa">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P2_1" name="Producto (sistema)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P2_2" name="Usuario">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesita un usuario">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Registrar datos y rol">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t2" name="Validar cupo de usuarios">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Hay cupo?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t3" name="Crear cuenta e invitar">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t4" name="Ver límite y pedir ampliar">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e2" name="Pendiente de ampliar (P4)">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t5" name="Activar cuenta y 2.º factor">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Usuario activo">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s2" name="Alguien deja la empresa">
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t6" name="Desactivar al usuario">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t7" name="Liberar el cupo">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e3" name="Cupo liberado">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="Sí" />
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t4" name="No" />
    <bpmn:sequenceFlow id="f6" sourceRef="t4" targetRef="e2" />
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="t5" />
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="e1" />
    <bpmn:sequenceFlow id="f9" sourceRef="s2" targetRef="t6" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="e3" />
  </bpmn:process>
