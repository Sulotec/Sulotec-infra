---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { pasos } from '../data/sitio';
---
<section class="metodologia" id="metodologia" aria-labelledby="titulo-metodologia">
  <div class="contenedor">
    <SectionTitle id="titulo-metodologia" kicker="Cómo trabajamos" titulo="Del diagnóstico a resultados medibles" bajada="Te acompañamos en cada etapa para que la solución funcione desde el primer día." centrado />
    <ol class="pasos">
      {pasos.map((p, i) => (
        <li class:list={['paso', 'revelar', { destacado: i === 1 }]} style={`--i:${i}`}>
          <span class="numero">{String(i + 1).padStart(2, '0')}</span>
          <span class="icono"><Icon name={p.icono} size={26} /></span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          {i < pasos.length - 1 && <span class="flecha" aria-hidden="true"><Icon name="arrow" size={22} /></span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .metodologia { padding: 100px 0 110px; background: var(--fondo-2); }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
  .paso { position: relative; background: #fff; border-radius: var(--radio); padding: 34px 28px 32px; box-shadow: var(--sombra); transition: transform .4s var(--curva), box-shadow .4s var(--curva); }
  .paso:hover { transform: translateY(-6px); box-shadow: var(--sombra-alta); }
  .numero { position: absolute; right: 24px; top: 16px; font-size: 2.8rem; font-weight: 700; color: var(--azul-10); line-height: 1; letter-spacing: -.02em; }
  .icono { position: relative; width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: var(--azul); color: #fff; margin-bottom: 22px; }
  .icono::before { content: ""; position: absolute; inset: -8px; border-radius: 50%; border: 2px dashed var(--azul-25); animation: girar 14s linear infinite; }
  h3 { font-size: 1.25rem; margin-bottom: 10px; }
  p { margin: 0; color: var(--gris); }
  /* Flecha roja que "empuja" hacia el siguiente paso */
  .flecha { position: absolute; right: -36px; top: 58px; color: var(--rojo); animation: empujar 1.6s ease-in-out infinite; }
  @keyframes empujar { 0%, 100% { transform: translateX(0); opacity: .6; } 50% { transform: translateX(6px); opacity: 1; } }

  .destacado { background: linear-gradient(150deg, var(--azul-claro), var(--azul) 60%, var(--azul-oscuro)); color: #fff; transform: translateY(-14px); box-shadow: var(--sombra-alta); }
  .destacado:hover { transform: translateY(-20px); }
  .destacado .icono { background: #fff; color: var(--azul); }
  .destacado .icono::before { border-color: rgba(255, 255, 255, .45); }
  .destacado .numero { color: rgba(255, 255, 255, .16); }
  .destacado p { color: #d7e0ef; }

  @media (max-width: 860px) {
    .pasos { grid-template-columns: 1fr; gap: 22px; }
    .flecha { display: none; }
    .destacado, .destacado:hover { transform: none; }
  }
</style>
