<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_P4" targetNamespace="http://sulotec.com/licencias" exporter="Sulotec" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_P4">
    <bpmn:participant id="Pool_P4" name="Sulotec · Renovación y ampliación" processRef="Proceso_P4" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P4" name="Renovación, ampliación y vencimiento" isExecutable="false">
    <bpmn:laneSet id="Carriles_P4">
      <bpmn:lane id="Carril_P4_0" name="Plataforma Sulotec">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P4_1" name="Administrador de empresa">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P4_2" name="Comercial Sulotec">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P4_3" name="Administrador universal">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="7 días antes del vencimiento">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Avisar vencimiento y consumo">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="s2" name="Pide ampliar desde la app">
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g1" name="¿Qué decide?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t2" name="Cotizar renovación o ampliación">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Pagar">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Actualizar la licencia">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t5" name="Aplicar en el producto">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Licencia vigente">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t6" name="Al vencer: 7 días solo lectura">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t7" name="Suspender acceso (datos a salvo)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e2" name="Licencia suspendida">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" sourceRef="s2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t2" name="Renovar o ampliar" />
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="e1" />
    <bpmn:sequenceFlow id="f9" sourceRef="g1" targetRef="t6" name="No renovar" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="e2" />
  </bpmn:process>
