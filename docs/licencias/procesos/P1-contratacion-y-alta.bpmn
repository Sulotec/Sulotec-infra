<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_P1" targetNamespace="http://sulotec.com/licencias" exporter="Sulotec" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_P1">
    <bpmn:participant id="Pool_P1" name="Sulotec · Contratación de licencia" processRef="Proceso_P1" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_P1" name="Contratación y alta de licencia" isExecutable="false">
    <bpmn:laneSet id="Carriles_P1">
      <bpmn:lane id="Carril_P1_0" name="Empresa cliente">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P1_1" name="Comercial Sulotec">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P1_2" name="Administrador Universal">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_P1_3" name="Plataforma Sulotec">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Pide un producto">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Cotizar el plan (usuarios y tokens)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="¿Acepta?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="No contrata">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t2" name="Firmar contrato y pagar">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Crear empresa y licencia">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t4" name="Sincronizar licencia al producto">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t5" name="Invitar al Admin. General">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t6" name="Enviar invitación por correo">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t7" name="Activar cuenta y 2.º factor">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Empresa operando">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" sourceRef="g1" targetRef="e0" name="No" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t2" name="Sí" />
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_P1">
    <bpmndi:BPMNPlane id="Plano_P1" bpmnElement="Colaboracion_P1">
      <bpmndi:BPMNShape id="Pool_P1_di" bpmnElement="Pool_P1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1380" height="440" />
