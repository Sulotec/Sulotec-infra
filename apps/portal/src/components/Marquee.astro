---
// Dos franjas de capacidades que se mueven en sentidos opuestos.
// La lista se repite por codigo (no a mano) para que el bucle no tenga cortes.
import { sitio } from '../data/sitio';
const filas = [
  { items: sitio.capacidades, inversa: false },
  { items: [...sitio.capacidades].reverse(), inversa: true },
];
const vueltas = [0, 1];
---
<div class="franja" role="region" aria-label="Capacidades de las soluciones">
  {filas.map((fila, f) => (
    <div class:list={['pista', { inversa: fila.inversa }]} aria-hidden={f === 1 ? 'true' : undefined}>
      {vueltas.map((v) => (
        <ul aria-hidden={v === 1 ? 'true' : undefined}>
          {fila.items.map((c) => <li>{c}</li>)}
        </ul>
      ))}
    </div>
  ))}
</div>

<style>
  .franja { overflow: hidden; padding: 26px 0; display: grid; gap: 14px; background: #fff; border-bottom: 1px solid var(--borde); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .pista { display: flex; width: max-content; animation: deslizar 46s linear infinite; }
  .inversa { animation-direction: reverse; animation-duration: 54s; }
  .franja:hover .pista { animation-play-state: paused; }
  ul { display: flex; list-style: none; margin: 0; padding: 0; }
  li { display: inline-flex; align-items: center; padding: 0 14px; white-space: nowrap; font-weight: 700; font-size: 1.02rem; color: var(--azul); }
  li::after { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--rojo); margin-left: 28px; }
  .inversa li { color: var(--azul-50); font-size: .95rem; }
  .inversa li::after { background: var(--azul-25); }
  @keyframes deslizar { to { transform: translateX(-50%); } }
</style>
