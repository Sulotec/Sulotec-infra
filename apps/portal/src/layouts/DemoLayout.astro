---
// Armazon comun de las demos: barra lateral, cabecera con aviso de "modo demo" e invitacion a crear cuenta.
import Base from './Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { sitio } from '../data/sitio';
import { cuenta, invitacion } from '../data/demos';
import { solucionesPublicas } from '../data/soluciones';

interface Props {
  producto: string;         // nombre del producto (igual que en soluciones.ts)
  titulo: string;           // titulo de la pantalla
  bajada: string;           // que se esta viendo, en una frase
  ruta: string;             // /demo/...
  menu: { texto: string; icono: IconName }[]; // opciones bloqueadas del producto
}
const { producto, titulo, bajada, ruta, menu } = Astro.props;
const demos = solucionesPublicas.filter((s) => s.demo);
const asunto = encodeURIComponent('Quiero crear mi cuenta Sulotec');
const asuntoAcceso = encodeURIComponent(`Quiero acceso a la demo completa de ${producto}`);
---
<Base titulo={`Demo de ${producto} | Sulotec`} descripcion={`Prueba ${producto} con datos de ejemplo.`} ruta={ruta}>
  <script is:inline slot="head" src="/demo.js" defer></script>
  <div class="app" data-acciones={invitacion.acciones} data-segundos={invitacion.segundos} data-consulta={invitacion.consulta}
    data-limite={cuenta.activa ? 'si' : undefined}>
    <aside class="lateral" aria-label="Productos">
      <a class="volver" href="/">
        <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#fff" /><path d="M42 22c-2-3-6-5-10-5-6 0-10 3-10 8 0 11 20 6 20 16 0 5-4 8-10 8-5 0-9-2-11-6" fill="none" stroke="#1b4589" stroke-width="5.5" stroke-linecap="round" /><circle cx="50" cy="50" r="4.5" fill="#ed1c24" /></svg>
        <span>sulotec</span>
      </a>
      <p class="grupo">Productos</p>
      <nav class="productos">
        {demos.map((s) => (
          <a href={s.demo} class:list={{ actual: s.nombre === producto }} aria-current={s.nombre === producto ? 'page' : undefined}>
            <Icon name={s.icono} size={18} />{s.nombre}
          </a>
        ))}
      </nav>
      <p class="grupo">{producto}</p>
      <nav class="opciones">
        {menu.map((m) => (
          <button type="button" data-bloqueado>
            <Icon name={m.icono} size={18} />{m.texto}<Icon name="lock" size={14} />
          </button>
        ))}
      </nav>
    </aside>

    <div class="cuerpo">
      <header class="barra">
        <div class="aviso"><span class="punto" aria-hidden="true"></span><span class="largo">Estás en modo demo: todo lo que ves son datos de ejemplo</span><span class="corto">Modo demo con datos de ejemplo</span></div>
        <div class="acciones">
          <a class="enlace" href="/">Volver a sulotec.com</a>
          {cuenta.activa ? (
            <>
              <button type="button" class="boton boton-azul pequeno solo-invitado" data-cuenta="ingresar">Iniciar sesión</button>
              <span class="saludo solo-sesion">Hola, <strong data-cuenta-nombre></strong></span>
              <button type="button" class="boton boton-azul pequeno solo-sesion" data-abrir-consulta>Agendar una consulta</button>
            </>
          ) : (
            <button type="button" class="boton boton-azul pequeno" data-abrir-invitacion>Crear cuenta</button>
          )}
        </div>
      </header>

      <main id="contenido" class="contenido">
        <div class="encabezado">
          <h1>{titulo}</h1>
          <p>{bajada}</p>
        </div>
        <slot />
      </main>
    </div>
  </div>

  <div class="aviso-bloqueo" role="status" aria-live="polite" hidden>Esta opción se habilita con tu cuenta</div>

  <dialog id="invitacion" aria-labelledby="titulo-invitacion">
    <svg class="curva" viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H400V40C260 90 120 30 0 70Z" fill="#1b4589" /><path d="M0 78C120 38 260 98 400 48" fill="none" stroke="#ed1c24" stroke-width="5" /></svg>
    <div class="dialogo">
      {cuenta.activa ? (
        <>
          <h2 id="titulo-invitacion">Inicia sesión para seguir explorando</h2>
          <p class="solo-obligatoria aviso-tiempo">Terminó tu recorrido libre de 2 minutos por las demos.</p>
          <p>Con tu cuenta Sulotec recorres la demo completa de {producto} sin límite de tiempo. ¿Aún no tienes cuenta? Solicítala y la creamos para tu empresa.</p>
          <div class="botones">
            <button type="button" class="boton boton-azul" data-cuenta="ingresar">Iniciar sesión</button>
            <a class="boton secundario" href={`mailto:${sitio.correo}?subject=${asuntoAcceso}`}>Solicitar acceso</a>
            <button type="button" class="boton secundario solo-suave" data-cerrar-invitacion>Seguir viendo la demo</button>
          </div>
          <p class="enlaces solo-obligatoria"><a href="/">Volver a sulotec.com</a></p>
        </>
      ) : (
        <>
          <h2 id="titulo-invitacion">Crea tu cuenta para seguir explorando</h2>
          <p>Las cuentas de Sulotec se habilitan muy pronto. Déjanos tu correo y te avisamos apenas estén listas para que veas la demo completa de {producto}.</p>
          <div class="botones">
            <a class="boton boton-azul" href={`mailto:${sitio.correo}?subject=${asunto}`}>Avísame por correo</a>
            <button type="button" class="boton secundario" data-cerrar-invitacion>Seguir viendo la demo</button>
          </div>
        </>
      )}
    </div>
  </dialog>

  <dialog id="consulta" aria-labelledby="titulo-consulta">
    <svg class="curva" viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H400V40C260 90 120 30 0 70Z" fill="#1b4589" /><path d="M0 78C120 38 260 98 400 48" fill="none" stroke="#ed1c24" stroke-width="5" /></svg>
    <div class="dialogo">
      <h2 id="titulo-consulta">Veamos esto con tu operación</h2>
      <p>En una consulta personalizada te mostramos cómo {producto} se adapta a tu equipo y resolvemos tus dudas. La demo usa solo datos de ejemplo: nunca te pediremos datos personales para probarla.</p>
      <div class="botones">
        <a class="boton boton-azul" data-consulta-correo data-producto={producto} href={`mailto:${sitio.correo}?subject=${encodeURIComponent(`Consulta personalizada: ${producto}`)}`}>Agendar una consulta</a>
        <button type="button" class="boton secundario" data-cerrar-consulta>Seguir viendo la demo</button>
      </div>
    </div>
  </dialog>
</Base>

<style>
  .app { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; background: var(--fondo); }

  /* Barra lateral */
  .lateral { position: sticky; top: 0; height: 100vh; overflow-y: auto; background: var(--azul-oscuro); color: #fff; padding: 22px 16px; display: flex; flex-direction: column; gap: 6px; }
  .volver { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-weight: 700; font-size: 1.2rem; padding: 4px 8px 18px; }
  .grupo { margin: 14px 8px 6px; font-size: .8rem; color: var(--azul-50); font-weight: 700; }
  .productos, .opciones { display: grid; gap: 2px; }
  .productos a, .opciones button {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 12px; border-radius: 10px;
    color: #d7e0ef; text-decoration: none; font: inherit; font-size: .95rem; background: none; border: 0; cursor: pointer; text-align: left;
  }
  .productos a:hover, .opciones button:hover { background: rgba(255, 255, 255, .07); color: #fff; }
  .productos a.actual { background: #fff; color: var(--azul); font-weight: 700; box-shadow: inset 4px 0 0 var(--rojo); }
  .opciones button :global(svg:last-child) { margin-left: auto; opacity: .55; }

  /* Cabecera */
  .cuerpo { min-width: 0; }
  .barra { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 28px; background: rgba(238, 242, 248, .9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--borde); }
  .aviso { display: inline-flex; align-items: center; gap: 10px; font-size: .9rem; font-weight: 700; color: var(--azul); }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--rojo); animation: pulso 2s infinite; flex: none; }
  .corto { display: none; }
  .acciones { display: flex; align-items: center; gap: 18px; }
  .enlace { color: var(--azul); font-weight: 700; text-decoration: none; font-size: .92rem; }
  .enlace:hover { text-decoration: underline; }
  .pequeno { padding: 9px 18px; border: 0; cursor: pointer; font: inherit; font-weight: 700; }
  .saludo { color: var(--gris); font-size: .92rem; }
  .saludo strong { color: var(--azul); }

  .contenido { padding: 28px; max-width: 1280px; }
  .encabezado { margin-bottom: 22px; }
  h1 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); color: var(--azul); letter-spacing: -.01em; }
  .encabezado p { margin: 6px 0 0; color: var(--gris); }

  /* Aviso al tocar algo bloqueado */
  .aviso-bloqueo { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); background: var(--texto); color: #fff; padding: 12px 20px; border-radius: 12px; font-weight: 700; font-size: .92rem; box-shadow: var(--sombra-alta); z-index: 60; }

  /* Invitacion */
  dialog { border: 0; padding: 0; border-radius: 22px; width: min(480px, 100% - 32px); box-shadow: var(--sombra-alta); overflow: hidden; }
  dialog::backdrop { background: rgba(18, 48, 95, .55); backdrop-filter: blur(3px); }
  dialog[open] { animation: subir .45s var(--curva) both; }
  .curva { display: block; width: 100%; height: 70px; }
  .dialogo { padding: 6px 30px 30px; }
  .dialogo h2 { font-size: 1.5rem; color: var(--azul); margin-bottom: 10px; }
  .dialogo p { color: var(--gris); margin: 0 0 22px; }
  .botones { display: flex; flex-wrap: wrap; gap: 10px; }
  .botones .boton { border: 0; cursor: pointer; font: inherit; font-weight: 700; }
  .secundario { background: var(--azul-10); color: var(--azul); }
  /* Invitacion suave (se puede cerrar) u obligatoria (termino el tiempo libre de la demo) */
  dialog:not([data-obligatoria]) .solo-obligatoria, dialog[data-obligatoria] .solo-suave { display: none; }
  .dialogo p.aviso-tiempo { color: var(--rojo); font-weight: 700; margin-bottom: 8px; }
  .dialogo .enlaces { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 18px 0 0; font-size: .92rem; }
  .enlaces a { color: var(--gris); }

  @media (max-width: 900px) {
    .app { grid-template-columns: 1fr; }
    .lateral { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 12px 16px; }
    .volver { padding: 4px 8px; }
    .grupo, .opciones { display: none; }
    .productos { display: flex; gap: 4px; overflow-x: auto; width: 100%; }
    .productos a { white-space: nowrap; width: auto; }
    .barra { padding: 10px 16px; gap: 10px; }
    .aviso { font-size: .84rem; }
    .largo { display: none; }
    .corto { display: inline; }
    .pequeno { padding: 8px 14px; font-size: .88rem; white-space: nowrap; }
    .contenido { padding: 20px 16px; }
    .enlace { display: none; }
  }
</style>
