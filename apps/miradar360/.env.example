# Plantilla de /opt/sulotec/miradar360.env (la copia scripts/preparar.sh; el archivo real NUNCA va al repositorio).
# Las lineas con PEGAR_DESDE_RENDER se llenan copiando el valor EXACTO desde Render -> afacop-backend -> Environment.
# scripts/desplegar.sh no arranca mientras quede alguna linea "PEGAR_".
#
# MUY IMPORTANTE: copiar TAL CUAL, no generar valores nuevos, en:
#   MFA_ENCRYPTION_KEY  -> si cambia, nadie puede entrar: los codigos MFA guardados quedan ilegibles.
#   JWT_SECRET          -> si cambia, se cierran todas las sesiones y se rompen las URLs firmadas de las evidencias.
#   B2_*                -> son las llaves del bucket privado de fotos y firmas.

# --- Base de datos (la crea scripts/preparar.sh; no tocar) ---
POSTGRES_PASSWORD=CLAVE_DB
DATABASE_URL=postgresql://radar:CLAVE_DB@miradar360-db:5432/radar?sslmode=disable

# --- Direcciones ---
NODE_ENV=production
PORT=4000
# Se usa al CONSTRUIR la web. Debe ser la direccion publica de la API.
# OJO: hoy el panel NO lee esta variable (en produccion usa siempre afacop-backend.onrender.com).
# Funciona solo despues del cambio previo en el panel; ver README.md, "Cambio previo en el panel web".
VITE_PROD_API_URL=https://api-miradar360.sulotec.com
# Origenes permitidos (CORS), exactos y sin "/" al final. Varios: separados por coma.
FRONTEND_URL=https://miradar360.sulotec.com
CORS_ALLOW_ALL=false
# Detras de Cloudflare Tunnel hay un proxy: la API debe leer la IP real del cliente.
TRUST_PROXY=true

# --- Secretos (copiar de Render) ---
JWT_SECRET=PEGAR_DESDE_RENDER
MFA_ENCRYPTION_KEY=PEGAR_DESDE_RENDER
INITIAL_ADMIN_USERNAME=Afacop
INITIAL_ADMIN_PASSWORD=PEGAR_DESDE_RENDER
RESET_INITIAL_ADMIN=false

# --- Sesion y MFA (valores actuales de Render) ---
REQUIRE_MFA=true
MFA_EXEMPT_USERNAMES=Afacop
JWT_EXPIRES_IN=8h
JWT_ADVISOR_EXPIRES_IN=15m
JWT_ISSUER=radar-360-api
JWT_AUDIENCE=radar-360-clients
MAX_LOGIN_FAILURES=5
ACCOUNT_LOCK_MINUTES=15
LOG_LEVEL=info

# --- Evidencias privadas en Backblaze B2 (copiar de Render) ---
B2_ENDPOINT=PEGAR_DESDE_RENDER
B2_REGION=PEGAR_DESDE_RENDER
B2_BUCKET=PEGAR_DESDE_RENDER
B2_KEY_ID=PEGAR_DESDE_RENDER
B2_APPLICATION_KEY=PEGAR_DESDE_RENDER

# --- Geocodificacion (copiar los valores que tenga Render) ---
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_PROVIDER=nominatim
# false durante el ensayo (Render sigue geocodificando); true solo el dia del cambio.
GEOCODING_WORKER_ENABLED=false
GEOCODING_BATCH_SIZE=5
# Solo si GEOCODING_PROVIDER=mapbox (descomentar y pegar):
# MAPBOX_ACCESS_TOKEN=
